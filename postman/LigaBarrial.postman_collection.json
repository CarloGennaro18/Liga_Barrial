        },
        {
          "name": "4.5 Modificar teléfono (PATCH)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/arbitros/{{arbitroId}}",
