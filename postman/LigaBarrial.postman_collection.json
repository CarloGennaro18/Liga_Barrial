            }
          }
        },
        { "name": "3.2 Listar jugadores", "request": { "method": "GET", "url": "{{baseUrl}}/jugadores" } },
        { "name": "3.3 Filtrar por equipo", "request": { "method": "GET", "url": "{{baseUrl}}/jugadores?equipoId={{equipoId}}" } },
        { "name": "3.4 Obtener jugador por id", "request": { "method": "GET", "url": "{{baseUrl}}/jugadores/{{jugadorId}}" } },
        {
          "name": "3.5 Reemplazar jugador (PUT)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/jugadores/{{jugadorId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Carlos Mamani Quispe\",\n  \"numeroCamiseta\": 9,\n  \"posicion\": \"delantero\",\n  \"equipoId\": \"{{equipoId}}\"\n}"
            }
          }
        },
        {
          "name": "3.6 Modificar posición (PATCH)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/jugadores/{{jugadorId}}",
            "body": { "mode": "raw", "raw": "{ \"posicion\": \"mediocampista\" }" }
          }
        },
        { "name": "3.7 Eliminar jugador", "request": { "method": "DELETE", "url": "{{baseUrl}}/jugadores/{{jugadorId}}" } }
      ]
    },
