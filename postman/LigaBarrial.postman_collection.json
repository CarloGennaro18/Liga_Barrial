    {
      "name": "6. Partidos",
      "item": [
        {
          "name": "6.1 Crear partido",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/partidos",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"campeonatoId\": \"{{campeonatoId}}\",\n  \"jornada\": 4,\n  \"equipoLocalId\": \"{{equipoLocalId}}\",\n  \"equipoVisitanteId\": \"{{equipoVisitanteId}}\",\n  \"arbitroId\": \"{{arbitroId}}\",\n  \"canchaId\": \"{{canchaId}}\",\n  \"fecha\": \"2026-10-12\",\n  \"hora\": \"18:30\"\n}"
            }
          }
        },
        { "name": "6.2 Listar partidos", "request": { "method": "GET", "url": "{{baseUrl}}/partidos" } },
        { "name": "6.3 Filtrar por campeonato", "request": { "method": "GET", "url": "{{baseUrl}}/partidos?campeonatoId={{campeonatoId}}" } },
        { "name": "6.4 Obtener partido por id", "request": { "method": "GET", "url": "{{baseUrl}}/partidos/{{partidoId}}" } },
        {
          "name": "6.5 Reemplazar partido (PUT)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/partidos/{{partidoId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"campeonatoId\": \"{{campeonatoId}}\",\n  \"jornada\": 4,\n  \"equipoLocalId\": \"{{equipoLocalId}}\",\n  \"equipoVisitanteId\": \"{{equipoVisitanteId}}\",\n  \"arbitroId\": \"{{arbitroId}}\",\n  \"canchaId\": \"{{canchaId}}\",\n  \"fecha\": \"2026-10-12\",\n  \"hora\": \"20:00\"\n}"
            }
          }
        },
        {
          "name": "6.6 Modificar hora (PATCH)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/partidos/{{partidoId}}",
            "body": { "mode": "raw", "raw": "{ \"hora\": \"19:00\" }" }
          }
        },
        {
          "name": "6.7 Registrar resultado",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/partidos/{{partidoId}}/resultado",
            "body": { "mode": "raw", "raw": "{ \"golesLocal\": 3, \"golesVisitante\": 1 }" }
          }
        },
        { "name": "6.8 Eliminar partido", "request": { "method": "DELETE", "url": "{{baseUrl}}/partidos/{{partidoId}}" } }
      ]
