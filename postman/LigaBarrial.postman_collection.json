      ]
    },
    {
      "name": "8. Tabla de Posiciones",
      "item": [
        {
          "name": "8.1 Obtener tabla del campeonato",
          "request": { "method": "GET", "url": "{{baseUrl}}/campeonatos/{{campeonatoId}}/tabla-posiciones" }
        }
      ]
    },
    {
      "name": "9. Casos de ERROR",
      "item": [
        {
          "name": "9.1 ERROR 400 - nombre muy corto",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/campeonatos",
            "body": { "mode": "raw", "raw": "{ \"nombre\": \"A\" }" }
          }
        },
        {
          "name": "9.2 ERROR 400 - campo extra no permitido",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/campeonatos",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Liga Test\",\n  \"temporada\": \"2026\",\n  \"fechaInicio\": \"2026-10-01\",\n  \"fechaFin\": \"2026-12-01\",\n  \"estado\": \"planificado\",\n  \"campoExtra\": \"no permitido\"\n}"
            }
          }
        },
        { "name": "9.3 ERROR 404 - campeonato no existe", "request": { "method": "GET", "url": "{{baseUrl}}/campeonatos/id-inventado" } },
        { "name": "9.4 ERROR 404 - eliminar inexistente", "request": { "method": "DELETE", "url": "{{baseUrl}}/campeonatos/id-inventado" } },
        {
          "name": "9.5 ERROR 400 - mismo equipo local y visitante",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/partidos",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"campeonatoId\": \"{{campeonatoId}}\",\n  \"jornada\": 1,\n  \"equipoLocalId\": \"{{equipoLocalId}}\",\n  \"equipoVisitanteId\": \"{{equipoLocalId}}\",\n  \"arbitroId\": \"{{arbitroId}}\",\n  \"canchaId\": \"{{canchaId}}\",\n  \"fecha\": \"2026-10-12\",\n  \"hora\": \"18:30\"\n}"
            }
          }
        },
        {
          "name": "9.6 ERROR 400 - goles negativos",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/partidos/{{partidoId}}/resultado",
            "body": { "mode": "raw", "raw": "{ \"golesLocal\": -1, \"golesVisitante\": 0 }" }
          }
        },
        {
          "name": "9.7 ERROR 400 - número de camiseta inválido",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/jugadores",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Jugador Test\",\n  \"numeroCamiseta\": 200,\n  \"posicion\": \"delantero\",\n  \"equipoId\": \"{{equipoId}}\"\n}"
            }
          }
        },
        {
          "name": "9.8 ERROR 404 - tabla sin equipos",
          "request": { "method": "GET", "url": "{{baseUrl}}/campeonatos/campeonato-vacio/tabla-posiciones" }
        }
      ]
    }
  ]
