{
  "info": {
    "name": "LigaBarrial",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000/api/v1" },
    { "key": "campeonatoId", "value": "" },
    { "key": "equipoId", "value": "" },
    { "key": "equipoLocalId", "value": "" },
    { "key": "equipoVisitanteId", "value": "" },
    { "key": "jugadorId", "value": "" },
    { "key": "arbitroId", "value": "" },
    { "key": "canchaId", "value": "" },
    { "key": "partidoId", "value": "" },
    { "key": "tarjetaId", "value": "" }
  ],
  "item": [
    {
      "name": "1. Campeonatos",
      "item": [
        {
          "name": "1.1 Crear campeonato",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/campeonatos",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Liga Barrial 2026\",\n  \"temporada\": \"2026-A\",\n  \"fechaInicio\": \"2026-10-10\",\n  \"fechaFin\": \"2026-12-20\",\n  \"estado\": \"planificado\"\n}"
            }
          }
        },
        { "name": "1.2 Listar campeonatos", "request": { "method": "GET", "url": "{{baseUrl}}/campeonatos" } },
        { "name": "1.3 Obtener campeonato por id", "request": { "method": "GET", "url": "{{baseUrl}}/campeonatos/{{campeonatoId}}" } },
        {
          "name": "1.4 Reemplazar campeonato (PUT)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/campeonatos/{{campeonatoId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Liga Barrial 2026 - Edición Especial\",\n  \"temporada\": \"2026-B\",\n  \"fechaInicio\": \"2026-11-01\",\n  \"fechaFin\": \"2027-01-15\",\n  \"estado\": \"en_curso\"\n}"
            }
          }
        },
        {
          "name": "1.5 Modificar estado (PATCH)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/campeonatos/{{campeonatoId}}",
            "body": { "mode": "raw", "raw": "{ \"estado\": \"en_curso\" }" }
          }
        },
        { "name": "1.6 Eliminar campeonato", "request": { "method": "DELETE", "url": "{{baseUrl}}/campeonatos/{{campeonatoId}}" } }
      ]
    },
    {
      "name": "2. Equipos",
      "item": [
        {
          "name": "2.1 Crear equipo local",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/equipos",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Deportivo San Roque\",\n  \"representante\": \"Juan Pérez\",\n  \"telefono\": \"70011223\"\n}"
            }
          }
        },
        {
          "name": "2.2 Crear equipo visitante",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/equipos",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Real Potosí Barrio\",\n  \"representante\": \"María López\",\n  \"telefono\": \"70044556\"\n}"
            }
          }
        },
        { "name": "2.3 Listar equipos", "request": { "method": "GET", "url": "{{baseUrl}}/equipos" } },
        { "name": "2.4 Obtener equipo por id", "request": { "method": "GET", "url": "{{baseUrl}}/equipos/{{equipoId}}" } },
        {
          "name": "2.5 Reemplazar equipo (PUT)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/equipos/{{equipoId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Deportivo San Roque FC\",\n  \"representante\": \"Juan Pérez\",\n  \"telefono\": \"70099999\"\n}"
            }
          }
        },
        {
          "name": "2.6 Modificar teléfono (PATCH)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/equipos/{{equipoId}}",
            "body": { "mode": "raw", "raw": "{ \"telefono\": \"71122334\" }" }
          }
        },
        {
          "name": "2.7 Inscribir equipo a campeonato",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/equipos/{{equipoId}}/inscripcion",
            "body": { "mode": "raw", "raw": "{ \"campeonatoId\": \"{{campeonatoId}}\" }" }
          }
        },
        { "name": "2.8 Eliminar equipo", "request": { "method": "DELETE", "url": "{{baseUrl}}/equipos/{{equipoId}}" } }
      ]
    },
    {
      "name": "3. Jugadores",
