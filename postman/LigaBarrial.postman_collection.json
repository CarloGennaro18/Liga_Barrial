        { "name": "7.3 Filtrar por partido", "request": { "method": "GET", "url": "{{baseUrl}}/tarjetas?partidoId={{partidoId}}" } },
        { "name": "7.4 Filtrar por jugador", "request": { "method": "GET", "url": "{{baseUrl}}/tarjetas?jugadorId={{jugadorId}}" } },
        { "name": "7.5 Obtener tarjeta por id", "request": { "method": "GET", "url": "{{baseUrl}}/tarjetas/{{tarjetaId}}" } },
        {
          "name": "7.6 Reemplazar tarjeta (PUT)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/tarjetas/{{tarjetaId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"partidoId\": \"{{partidoId}}\",\n  \"jugadorId\": \"{{jugadorId}}\",\n  \"tipo\": \"roja\",\n  \"minuto\": 80,\n  \"motivo\": \"Conducta violenta\"\n}"
            }
          }
